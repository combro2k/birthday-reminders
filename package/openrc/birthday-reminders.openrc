#!/sbin/openrc-run

name="birthday-reminders"
description="Birthday Reminders"

command="/opt/birthday-reminders/bin/birthday-reminders"
command_args="--config /opt/birthday-reminders/etc/config.yaml serve"
command_user="root:root"
command_background=true

pidfile="/run/${RC_SVCNAME}.pid"
directory="/opt/birthday-reminders"

depend() {
	need net
	after postgresql
}

start_pre() {
	checkpath --directory --owner root:root /run
}
