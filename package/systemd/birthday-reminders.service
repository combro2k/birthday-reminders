[Unit]
Description=Birthday Reminders
After=network-online.target postgresql.service
Wants=network-online.target


[Service]
Type=simple
# Run as root, app will drop privileges itself
User=root
Group=root
ExecStart=/usr/bin/birthday-reminders --config /etc/birthday-reminders/config.yaml serve
WorkingDirectory=/var/lib/birthday-reminders
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Allow read access to config and write to data
ReadOnlyPaths=/etc/birthday-reminders
ReadWritePaths=/var/lib/birthday-reminders

[Install]
WantedBy=multi-user.target
