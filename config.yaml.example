database:
  # Database connection URL (supports sqlite://, mysql:// and postgres://) [required]
  # For SQLite, add ?mode=rwc to create the file if it does not exist
  url: "sqlite:///var/lib/birthday-reminders/birthday_reminders.db?mode=rwc"
  # PostgreSQL example:
  # url: "postgres://birthday:birthday@localhost:5432/birthday_reminders"
  # MySQL example:
  # url: "mysql://birthday:birthday@localhost:3306/birthday_reminders"
  # Maximum number of connections in the database pool (default: 10)
  # max_connections: 10

server:
  # Address and port to bind the HTTP server to [required]
  listen: "0.0.0.0:3000"
  # Public host[:port] used to derive callback URLs and links when base_url is omitted [recommended]
  server_name: "birthdays.example.com"
  # Public scheme used with server_name (default: "http")
  # scheme: "https"
  # Optional full public URL override for reverse proxies, non-root mounts, or unusual ports
  # base_url: "https://birthdays.example.com/app"
  # Secret key for signing session cookies (must be random, at least 32 chars in production) [required]
  session_secret: "change-me-to-a-random-string-in-production!"
  # Encryption key for notification channel secrets [required]
  # Generate with: openssl rand -base64 32
  encryption_key: "generate-a-random-key-for-encryption-here"
  # Path to static files directory (default: "/var/lib/birthday-reminders/static")
  # static_dir: "/var/lib/birthday-reminders/static"
  # Trust forwarded IP headers only from these proxy IPs or CIDR ranges (default: [])
  # trusted_proxies:
  #   - "127.0.0.1"
  #   - "10.0.0.0/8"
  # Migrations are now embedded in the binary for security and reliability.
  # User and group to run the app as (required, can be 'root' if desired)
  run_as_user: "birthday-reminders"
  run_as_group: "birthday-reminders"

auth:
  # Whether new users can self-register (default: false)
  # allow_registration: false
  # oidc:
  #   # Whether OIDC is enabled (default: false)
  #   enabled: true
  #   provider_name: "Keycloak"
  #   issuer_url: "https://keycloak.example.com/realms/myrealm"
  #   client_id: "birthday-reminders"
  #   client_secret: "your-client-secret"
  #   # Scopes to request (default: ["openid", "profile", "email"])
  #   scopes: ["openid", "profile", "email"]
  #   # Additional trusted `aud` values in ID tokens (optional).
  #   # Use this only if your provider includes extra audiences besides client_id.
  #   # trusted_audiences: ["account", "birthday-api"]
  #   # Trust all additional audiences when they are provider-managed and dynamic.
  #   # client_id and azp checks still remain enforced by OIDC verification.
  #   # allow_dynamic_additional_audiences: false
  #   # Automatically create local user accounts on first OIDC login (default: true)
  #   auto_provision: true
  #   # Default role assigned to auto-provisioned users (default: "user")
  #   default_role: "user"
  #
  # # Authentik example:
  # oidc:
  #   enabled: true
  #   provider_name: "Authentik"
  #   issuer_url: "https://authentik.example.com/application/o/birthday-reminders/"
  #   client_id: "birthday-reminders"
  #   client_secret: "your-client-secret"
  #
  # # Zitadel example:
  # oidc:
  #   enabled: true
  #   provider_name: "Zitadel"
  #   issuer_url: "https://zitadel.example.com"
  #   client_id: "123456@birthday-reminders"
  #   client_secret: "your-client-secret"
  #   allow_dynamic_additional_audiences: true

# The entire reminders section is optional (all fields have defaults)
reminders:
  # Cron expression for when to check and send reminders (default: "0 0 8 * * *" = daily at 08:00)
  # schedule: "0 0 8 * * *"
  # How many days before a birthday to send reminders (default: [7, 3, 1, 0])
  # default_days_before: [7, 3, 1, 0]

# The entire mcp section is optional (all fields have defaults)
mcp:
  # Enable streamable HTTP MCP endpoint on the same application port (default: true)
  # enabled: true
  # Route path for MCP endpoint (default: "/mcp")
  # path: "/mcp"
  # Streamable HTTP session mode (default: true)
  # stateful_mode: true
  # Return JSON directly in stateless mode (default: false)
  # json_response: false
  # Optional explicit Host allowlist for MCP requests; if omitted, localhost + server_name/base_url hosts are used
  # allowed_hosts:
  #   - "birthdays.example.com"
  # Optional Origin allowlist for browser-based MCP clients
  # allowed_origins:
  #   - "https://birthdays.example.com"

# The entire commands section is optional (all fields have defaults)
commands:
  # Signal transport backend: "cli" (default) or "api"
  # signal_transport: "cli"
  # Path to the signal-cli executable used by the Signal notification channel (default: "signal-cli")
  # signal_cli_path: "/usr/local/bin/signal-cli"
  # Base URL for signal-cli-api when signal_transport is set to "api" (default: "http://127.0.0.1:8080")
  # signal_api_url: "http://127.0.0.1:8080"

# The entire logging section is optional (all fields have defaults)
logging:
  # Log output: "stdout" or "syslog" (default: "stdout")
  # output: "stdout"
  # Log level filter, supports RUST_LOG syntax (default: "info")
  # E.g. "debug", "birthday_reminders=debug,tower_http=info"
  # level: "info"
